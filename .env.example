# OneDrive / Microsoft Graph Configuration
# Get these values from Azure AD app registration
ONEDRIVE_CLIENT_ID=your_client_id_here
ONEDRIVE_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient

# Backend API Configuration
API_BASE_URL=https://api.api-bilder-app.de

# SharePoint Configuration
SHAREPOINT_HOSTNAME=https://tenant.sharepoint.com
SHAREPOINT_SITE_ID=your_site_id_here
SHAREPOINT_DRIVE_ID=your_drive_id_here
SHAREPOINT_APP_FOLDER=GRAVIT_UPLOADS

# Mobilfunk 26 Configuration (Shared Folder)
MOBILFUNK26_DRIVE_ID=your_drive_id_here
MOBILFUNK26_ITEM_ID=your_item_id_here
MOBILFUNK26_SUB_PATH=BilderApp

# File Storage Configuration
PICTURES_ROOT_PATH=/storage/emulated/0/Pictures/BilderApp
ONEDRIVE_BASE_PATH=/test

# App Configuration
APP_NAME=GRAVIT DOKU HELPER
APP_VERSION=1.0.0
